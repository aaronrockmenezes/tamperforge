# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/

# Models / large artifacts (regenerate via experiments)
*.pt
*.safetensors
abliterated_*/
wandb/
# Exported HF model dirs: safetensors already ignored, but the tokenizer.json /
# config.json siblings are multi-MB each and are not research artifacts.
# Force-add provenance metas (*_meta.json) individually when they matter.
outputs/

# Results: keep only compact manifests and summaries in source
results/**
!results/**/
!results/**/manifest.json
!results/**/summary.json
!results/.gitkeep
# by_model/ is a pure symlink index (model -> version -> arm view over the real dirs above),
# not raw data -- see results/README.md. Trivial size, worth versioning so a fresh clone gets
# the same browsing structure.
!results/by_model/**

# Env / OS
.env
data/private/
.DS_Store
.venv/

README_hf.md
*.log

# Generated by chain_2gpu.sh per run (train_*.sh, stage_*.sh) -- rerunnable from the chain script
# itself, not source. results/** above already covers manifests/events but not these launchers.
logs/training_runs/train_*.sh
logs/eval/stage_*.sh
